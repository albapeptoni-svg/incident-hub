# SIEC Flow AI - environment example
#
# Copy only the variables needed by each runtime.
# VITE_* variables are public and are bundled into the browser.

# Frontend: Vercel Project Settings > Environment Variables
VITE_DATA_MODE=real
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-supabase-anon-key

# Frontend OCR endpoint.
# Local:
# VITE_GEMINI_API_URL=http://localhost:8787/api/analizar-parte
# Production recommended:
# VITE_GEMINI_API_URL=https://your-project-ref.supabase.co/functions/v1/gemini-ocr
# Never point this directly to generativelanguage.googleapis.com.
VITE_GEMINI_API_URL=http://localhost:8787/api/analizar-parte

# Backend-only for local Node/Express server/index.js.
# Do not add these to frontend-only Vercel deployments.
GEMINI_API_KEY=your-backend-gemini-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_SERVER_PORT=8787
GEMINI_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
PORT=8787

# Backend-only for server/index.js JWT/profile validation.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-backend-only-service-role-key

# Supabase Edge Function secrets/config.
# Set these with Supabase CLI or Dashboard, not as browser variables.
# The function also receives SUPABASE_URL and SUPABASE_ANON_KEY from Supabase.
OCR_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,https://your-app.vercel.app

# Never put secrets behind VITE_.
# Never use VITE_GEMINI_API_KEY.
# Never use VITE_SUPABASE_SERVICE_ROLE_KEY.
# Never use VITE_SIEC_PASSWORD.
# Never call Google Gemini directly from React.
