VITE_DATA_MODE=real
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-supabase-anon-key

# Browser client endpoint for the secure Gemini backend/proxy.
# Must point to your backend or Supabase Edge Function, never directly to Google Gemini.
VITE_GEMINI_API_URL=http://localhost:8787/api/analizar-parte

# Backend-only. Do not prefix with VITE_ and do not expose these to the browser.
GEMINI_API_KEY=your-backend-gemini-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_SERVER_PORT=8787
GEMINI_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
PORT=8787

# Required by server/index.js to validate OCR JWT/profile.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-backend-only-service-role-key

# Required by Supabase Edge Function CORS hardening.
OCR_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,https://your-app.vercel.app

# Never use VITE_GEMINI_API_KEY.
# Never use VITE_SUPABASE_SERVICE_ROLE_KEY.
# Never call Google Gemini directly from React.
